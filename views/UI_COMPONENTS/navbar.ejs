<nav class="navbar navbar-expand-lg navbar-dark bg-dark border-bottom border-secondary shadow-sm py-2">
  <div class="container">
    <!-- Brand Logo / Name Link -->
    <a class="navbar-brand fw-bold fs-4 d-flex align-items-center" href="/question">
      <i class="bi bi-journal-text me-2 text-primary"></i>QNotes
    </a>

    <!-- Mobile Responsive Toggle Hamburger Button -->
    <button class="navbar-toggler border-0 focus-none" type="button" data-bs-toggle="collapse" data-bs-target="#qnotesNavbarContent" aria-controls="qnotesNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Collapsible Menu Content Wrapper -->
    <div class="collapse navbar-collapse" id="qnotesNavbarContent">
      <!-- Nav Links Navigation Items -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
        <li class="nav-item">
          <a class="nav-link px-3 active" aria-current="page" href="/question">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
      </ul>

      <!-- Interactive Search Bar Filter Input -->
      <!-- আপনার স্টাইল মডিউল এবং বুটস্ট্র্যাপ ডিজাইন হুবহু একই রাখা হয়েছে -->
      <form class="d-flex my-2 my-lg-0 me-lg-3 w-100 style-search-form" style="max-width: 400px" role="search" action="/question" method="GET">
        <div class="input-group">
          <!-- পরিবর্তন: name="tag" করা হয়েছে এবং value যুক্ত করা হয়েছে -->
          <input class="form-control bg-secondary text-white border-secondary shadow-none placeholder-light-subtle" type="search" name="tag" placeholder="Search by tags (e.g. bba, cse, math)..." aria-label="Search" value="<%= (typeof currentSearchTag !== 'undefined' && currentSearchTag) ? currentSearchTag : '' %>" />

          <button class="btn btn-outline-primary border-secondary bg-secondary-subtle" type="submit">
            <i class="bi bi-search text-white"></i>
          </button>
        </div>
      </form>




      <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-2 pt-2 pt-lg-0 ms-lg-2">

        <!-- 'Upload Question' বাটনটি সবসময় দেখাবে (মোবাইলে ফুল-উইডথ হবে) -->
        <a href="/question/new" class="btn btn-primary fw-semibold btn-sm px-3 shadow-sm text-nowrap">
          <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Question
        </a>

        <!-- প্রোফাইল ড্রপডাউন পিল বাটন -->
        <div class="dropdown w-100 w-lg-auto mt-2 mt-lg-0">
          <button class="btn btn-outline-secondary border-secondary text-white rounded-pill d-flex align-items-center justify-content-between justify-content-lg-center gap-2 px-3 py-1.5 shadow-sm bg-transparent w-100 w-lg-auto" type="button" data-bs-toggle="dropdown" aria-expanded="false" style="transition: all 0.2s ease;">
            <!-- বামপাশে হ্যামবার্গার আইকন -->
            <i class="bi bi-list fs-5"></i>

            <!-- ডাইনামিক হিউম্যান প্রোফাইল আইকন (Bootstrap Icons ব্যবহার করা হয়েছে) -->
            <% if (currentUser) { %>
            <!-- ইউজার লগইন থাকলে আইকনটি প্রাইমারি কালার (নীল) হবে -->
            <i class="bi bi-person-circle fs-5 text-primary"></i>
            <% } else { %>
            <!-- ইউজার লগইন না থাকলে সাধারণ সাদা/ধূসর আইকন -->
            <i class="bi bi-person-circle fs-5 text-white-50"></i>
            <% } %>
          </button>

          <!-- ড্রপডাউন মেনু অপশনসমূহ (ডার্ক থিমের সাথে মিলিয়ে ডিজাইন করা) -->
          <ul class="dropdown-menu dropdown-menu-end shadow-lg border-secondary bg-dark text-white rounded-3 mt-2 p-2" style="min-width: 200px;">
            <% if (!currentUser) { %>
            <!-- ইউজার লগইন না থাকলে শুধুমাত্র লগইন ও সাইন-আপ অপশন দেখাবে -->
            <li>
              <a class="dropdown-item text-white py-2" href="/login" style="border-radius: 6px;">
                <i class="bi bi-box-arrow-in-right me-2"></i>Log In
              </a>
            </li>
            <li>
              <a class="dropdown-item text-white py-2 fw-semibold" href="/signup" style="border-radius: 6px;">
                <i class="bi bi-person-plus me-2"></i>Sign Up
              </a>
            </li>
            <% } else { %>
            <!-- ইউজার লগইন থাকলে সাইন-আপ/লগইন হাইড হয়ে এগুলো দেখাবে -->
            <li>
              <div class="px-3 py-2 small text-muted border-bottom border-secondary mb-1">
                Hello, <span class="text-white fw-bold"><%= currentUser.username %></span>
              </div>
            </li>
            <!-- আপনার কোনো বুকিং বা ড্যাশবোর্ড পেজ থাকলে এখানে লিংক দিতে পারেন -->
            <li>
              <a class="dropdown-item text-white py-2" href="/question" style="border-radius: 6px;">
                <i class="bi bi-journal-bookmark me-2"></i>My Workspace
              </a>
            </li>
            <li>
              <hr class="dropdown-divider border-secondary">
            </li>
            <li>
              <a class="dropdown-item text-danger py-2 fw-bold" href="/logout" style="border-radius: 6px;">
                <i class="bi bi-box-arrow-left me-2"></i>Log Out
              </a>
            </li>
            <% } %>
          </ul>
        </div>

      </div>

    </div>
  </div>
</nav>