<nav class="navbar navbar-expand-lg navbar-dark bg-dark-custom border-bottom border-dark shadow-sm py-2">
  <div class="container">
    
    <!-- ব্র্যান্ড লোগো এবং নাম -->
    <a class="navbar-brand fw-bold fs-4 d-flex align-items-center logo-custom" href="/question">
      <div class="logo-icon-box me-2 d-flex align-items-center justify-content-center">
        <i class="bi bi-journal-text text-primary"></i>
      </div>
      QNotes
    </a>

    <!-- মোবাইল রেসপন্সিভ হ্যামবার্গার বাটন -->
    <button class="navbar-toggler border-0 focus-none p-1" type="button" data-bs-toggle="collapse" data-bs-target="#qnotesNavbarContent" aria-controls="qnotesNavbarContent" aria-expanded="false" aria-label="Toggle navigation">
      <i class="bi bi-list fs-2 text-white"></i>
    </button>

    <!-- কলাপসিবল মেনু কনটেন্ট -->
    <div class="collapse navbar-collapse" id="qnotesNavbarContent">
      
      <!-- হোম লিংক -->
      <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
        <li class="nav-item">
          <a class="nav-link px-3 active-nav-link" aria-current="page" href="/question">
            <i class="bi bi-house-door me-1"></i> Home
          </a>
        </li>
      </ul>

      <!-- সার্চ বার সেকশন -->
      <form class="d-flex my-3 my-lg-0 me-lg-4 w-100 search-form-custom" style="max-width: 420px" role="search" action="/question" method="GET">
        <div class="input-group">
          <span class="input-group-text bg-search border-0 text-muted"><i class="bi bi-search"></i></span>
          <input class="form-control bg-search text-white border-0 shadow-none placeholder-custom" type="search" name="tag" placeholder="Search by tags (e.g. cse, bba, math)..." aria-label="Search" value="<%= (typeof currentSearchTag !== 'undefined' && currentSearchTag) ? currentSearchTag : '' %>" />
        </div>
      </form>

      <!-- রাইট সাইড অ্যাকশন আইটেমস -->
      <div class="d-flex flex-column flex-lg-row align-items-stretch align-items-lg-center gap-3 pt-2 pt-lg-0">
        
        <!-- আপলোড বাটন -->
        <a href="/question/new" class="btn btn-primary-custom fw-semibold btn-sm px-4 py-2 shadow-sm text-nowrap text-center">
          <i class="bi bi-cloud-arrow-up-fill me-1"></i> Upload Question
        </a>

        <!-- প্রোফাইল / ইউজার ড্রপডাউন মেনু -->
        <div class="dropdown w-100 w-lg-auto">
          <button class="btn profile-trigger-btn d-flex align-items-center justify-content-between justify-content-lg-center gap-2 px-2 py-1 bg-transparent w-100 w-lg-auto" type="button" data-bs-toggle="dropdown" aria-expanded="false">
            
            <% if (currentUser) { %>
              <!-- ইউজার লগইন থাকলে: প্রোফাইল পিকচার অথবা নামের প্রথম অক্ষর -->
              <div class="avatar-box shadow-sm">
                <% if (currentUser.profilePicture) { %>
                  <img src="<%= currentUser.profilePicture %>" alt="Profile" class="avatar-img">
                <% } else { %>
                  <span class="avatar-letter"><%= currentUser.name.charAt(0).toUpperCase() %></span>
                <% } %>
              </div>
              <span class="text-white d-lg-none fw-semibold ms-2"><%= currentUser.name %></span>
            <% } else { %>
              <!-- ইউজার লগইন না থাকলে ডিফল্ট আইকন -->
              <div class="avatar-box default-avatar">
                <i class="bi bi-person-circle fs-5 text-white-50"></i>
              </div>
              <span class="text-white d-lg-none fw-semibold ms-2">Account</span>
            <% } %>
            
            <i class="bi bi-chevron-down text-white-50 small d-none d-lg-inline-block"></i>
          </button>

          <!-- ড্রপডাউন কার্ড এরিয়া -->
          <ul class="dropdown-menu dropdown-menu-end shadow-xl border-0 dropdown-menu-custom mt-2 p-2" style="min-width: 240px;">
            <% if (!currentUser) { %>
              <!-- লগইন না থাকা অবস্থার অপশন -->
              <li>
                <a class="dropdown-item py-2.5 px-3" href="/login">
                  <i class="bi bi-box-arrow-in-right me-2 text-primary fs-5"></i> Log In
                </a>
              </li>
            <% } else { %>
              <!-- লগইন থাকা অবস্থায় প্রিমিয়াম প্রোফাইল কার্ড -->
              <li>
                <div class="px-3 py-3 border-bottom border-dark-subtle mb-2 text-start card-profile-header">
                  <div class="fw-bold text-white fs-6 text-truncate mb-0"><%= currentUser.name %></div>
                  <div style="color: white !important;" class="text-muted small text-truncate mb-1">@<%= currentUser.username %></div>
                  <% if (currentUser.university && currentUser.university !== "Not Provided Yet") { %>
                    <div class="badge bg-dark-subtle text-primary-light text-truncate max-w-100 border border-secondary mt-1 text-wrap text-start d-block">
                      <i class="bi bi-building-fill me-1"></i><%= currentUser.university %>
                    </div>
                  <% } %>
                </div>
              </li>
              <li>
                <a class="dropdown-item py-2 px-3" href="/question">
                  <i class="bi bi-journal-bookmark me-2 text-muted" style="color: white !important;"></i> My Workspace
                </a>
              </li>
              <li>
                <hr class="dropdown-divider border-dark-subtle my-2">
              </li>
              <li>
                <a class="dropdown-item text-danger py-2 px-3 fw-bold" href="/logout">
                  <i class="bi bi-box-arrow-left me-2"></i> Log Out
                </a>
              </li>
            <% } %>
          </ul>
        </div>

      </div>
    </div>
  </div>
</nav>
