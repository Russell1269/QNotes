<footer
  class="bg-dark text-white pt-5 pb-3 border-top border-secondary mt-auto"
>
  <div class="container">
    <div class="row g-4">
      <!-- Column 1: Brand & Description -->
      <div class="col-12 col-md-4 text-center text-md-start">
        <h5
          class="fw-bold mb-3 d-flex align-items-center justify-content-center justify-content-md-start"
        >
          <i class="bi bi-journal-text me-2 text-primary"></i>QNotes
        </h5>
        <p class="text-white-50 small" style="line-height: 1.6">
          Your trusted academic archive for quick access to previous year
          university question papers, session collections, and structured course
          materials.
        </p>
      </div>

      <!-- Column 2: Quick Links Navigation -->
      <div class="col-6 col-md-4 text-center">
        <h6
          class="text-uppercase fw-bold text-primary mb-3 small tracking-wider"
        >
          Quick Navigation
        </h6>
        <ul class="list-unstyled mb-0">
          <li class="mb-2">
            <a
              href="/question"
              class="text-white-50 text-decoration-none small hover-link"
              >Home Gallery</a
            >
          </li>
          <li class="mb-2">
            <a
              href="/question/new"
              class="text-white-50 text-decoration-none small hover-link"
              >Upload Document</a
            >
          </li>
        </ul>
      </div>

      <!-- Column 3: Contact & Info -->
      <div class="col-6 col-md-4 text-center text-md-end">
        <h6
          class="text-uppercase fw-bold text-primary mb-3 small tracking-wider"
        >
          Platform Status
        </h6>
        <p class="text-white-50 small mb-1">
          <i class="bi bi-cpu me-1"></i> Database: Connected
        </p>
        <p class="text-white-50 small mb-0">
          <i class="bi bi-shield-check me-1"></i> Public Access Sandbox
        </p>
      </div>
    </div>

    <!-- Divider Line -->
    <hr class="border-secondary my-4" />

    <!-- Bottom Copyright Area -->
    <div class="row align-items-center">
      <div class="col-12 col-md-6 text-center text-md-start mb-2 mb-md-0">
        <p class="text-white-50 small mb-0">
          &copy; <%= new Date().getFullYear() %> QNotes Repository. All rights
          reserved.
        </p>
      </div>
      <div class="col-12 col-md-6 text-center text-md-end">
        <div class="d-flex justify-content-center justify-content-md-end gap-3">
          <a href="#" class="text-white-50 hover-icon"
            ><i class="bi bi-github fs-5"></i
          ></a>
          <a href="#" class="text-white-50 hover-icon"
            ><i class="bi bi-linkedin fs-5"></i
          ></a>
        </div>
      </div>
    </div>
  </div>
</footer>
