<div class="flash-alert-container">

  <!-- Success Message -->
  <% if(successMsg && successMsg.length){ %>
  <div class="alert alert-success alert-dismissible fade show custom-flash-alert" role="alert">
    <i class="fa-solid fa-circle-check flash-icon"></i>
    <div class="flex-grow-1">
      <p class="flash-msg-text"><%= successMsg %></p>
    </div>
    <button type="button" class="btn-close ms-auto p-0 position-relative" data-bs-dismiss="alert" aria-label="Close" style="top: 0; right: 0;"></button>
  </div>
  <% } %>

  <!-- Error Message -->
  <% if(errorMsg && errorMsg.length){ %>
  <div class="alert alert-danger alert-dismissible fade show custom-flash-alert" role="alert">
    <i class="fa-solid fa-circle-exclamation flash-icon"></i>
    <div class="flex-grow-1">
      <p class="flash-msg-text"><%= errorMsg %></p>
    </div>
    <button type="button" class="btn-close ms-auto p-0 position-relative" data-bs-dismiss="alert" aria-label="Close" style="top: 0; right: 0;"></button>
  </div>
  <% } %>

</div>