<% layout('LAYOUT/boilarplate') -%>

<!-- Hero Header -->
<header class="hero-section shadow-sm mb-5">
  <div class="container text-center">
    <h1 class="display-5 fw-bold">Academic Question Repository</h1>
    <p class="lead opacity-75">Find, view, and download previous year question papers easily.</p>
  </div>
</header>

<!-- Main Content Container -->
<main class="container mb-5">
  <div class="row g-4">
    <% if (questions && questions.length > 0) { %>
    <% questions.forEach(function(question) { %>

    <div class="col-12 col-md-6 col-lg-4 d-flex align-items-stretch mb-4">
      <div class="card w-100 shadow-sm question-card tech-card rounded-4 overflow-hidden d-flex flex-column" style="transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);">

        <div class="position-relative overflow-hidden" style="height: 150px;">
          <img src="<%= (question.imageUrl && question.imageUrl.url && question.imageUrl.url.length > 0) ? question.imageUrl.url[0] : 'https://unsplash.com' %>" class="card-img-top w-100 h-100 object-fit-cover" alt="Question Banner">
          <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.4) 0%, rgba(0,0,0,0.05) 50%, rgba(15, 23, 42, 0.95) 100%);"></div>

          <!-- Professional Exam Type & Batch Row Badge Layout -->
          <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(15, 23, 42, 0.6) 0%, rgba(15, 23, 42, 0) 60%, rgba(1e, 29, 3b, 0.95) 100%);"></div>
          <div class="position-absolute top-0 start-0 end-0 d-flex justify-content-between align-items-center w-100 px-3 pt-3" style="z-index: 5;">
            <!-- Exam Type Badge -->
            <% if (question.examType) { %>
            <span class="badge text-white px-2.5 py-1.5 rounded-3 fw-bold text-uppercase border" style="font-size: 0.65rem; letter-spacing: 0.8px; background: rgba(15, 23, 42, 0.65) !important; backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border-color: rgba(255, 255, 255, 0.15) !important;">
              <i class="bi bi-file-earmark-text me-1 text-warning"></i> <%= question.examType %>
            </span>
            <% } %>

            <!-- Batch Badge -->
            <% if (question.batch) { %>
            <span class="badge text-white px-2.5 py-1.5 rounded-3 fw-bold border" style="font-size: 0.65rem; letter-spacing: 0.5px; background: linear-gradient(135deg, #0ea5e9 0%, #0284c7 100%) !important; border-color: rgba(14, 165, 233, 0.3) !important;">
              <i class="bi bi-layers-half me-1"></i><%= question.batch %>
            </span>
            <% } %>
          </div>
        </div>

        <!-- Premium Slate Card Body -->
        <div class="card-body d-flex flex-column p-4 pt-3">

          <!-- Subject & Calendar Metadata Segment -->
          <div class="d-flex align-items-center justify-content-between gap-2 mb-3">
            <div class="min-w-0 flex-grow-1" style="max-width: 65%;">
              <span class="badge bg-subject-pill text-cyan-accent border border-cyan-dim px-2.5 py-1.5 rounded-pill text-truncate fw-semibold d-inline-block w-100 text-start" title="<%= question.subject %>" style="font-size: 0.68rem; letter-spacing: 0.3px;">
                <i class="bi bi-bookmark-star-fill me-1"></i><%= question.subject %>
              </span>
            </div>

            <% if(question.year || question.session) { %>
            <div class="d-flex align-items-center text-slate-muted gap-1 flex-shrink-0" style="font-size: 0.72rem;">
              <i class="bi bi-calendar3 text-cyan-accent"></i>
              <span class="fw-semibold text-white-75">
                <%= question.year %>
                <% if(question.session) { %>
                <span class="text-slate-muted font-monospace" style="font-size: 0.65rem;">[<%= question.session %>]</span>
                <% } %>
              </span>
            </div>
            <% } %>
          </div>

          <!-- Active Interactive Title Resource -->
          <h5 class="card-title text-white fw-bold mb-2 text-truncate" title="<%= question.title %>" style="font-size: 1.15rem; letter-spacing: -0.3px;">
            <a href="/question/<%= question._id %>" class="text-white text-decoration-none hover-cyan-text">
              <%= question.title %>
            </a>
          </h5>

          <!-- Clean Text Summary Layout -->
          <p class="card-text text-slate-muted small mb-4 overflow-hidden flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; line-height: 1.6; min-height: 3.2em;">
            <%= question.description || 'No description provided for this academic archive resource.' %>
          </p>

          <!-- System Inline Tags Layout -->
          <% if (question.tags && question.tags.length > 0) { %>
          <div class="mb-4 text-truncate w-100">
            <% question.tags.forEach(function(tag) { %>
            <span class="badge bg-tag-pill text-cyan-accent me-1 mb-1 p-1.5 px-2 rounded-2 font-monospace" style="font-size: 0.65rem;">#<%= tag %></span>
            <% }) %>
          </div>
          <% } else { %>
          <div class="mb-2"></div>
          <% } %>

          <!-- Bottom Profile Context & Button Actions Setup -->
          <div class="mt-auto pt-3 border-top border-slate d-flex justify-content-between align-items-center">

            <!-- Beautiful Contained Owner Badge Profile -->
            <div class="d-flex align-items-center bg-transparent min-w-0" style="max-width: 60%;">
              <div class="me-2 text-secondary fs-4 d-flex align-items-center bg-avatar-frame border border-avatar p-1.5 rounded-circle shadow-inner">
                <i class="bi bi-person-badge text-cyan-accent" style="font-size: 1rem;"></i>
              </div>
              <div class="d-flex flex-column lh-sm min-w-0">
                <span class="fw-bold text-white text-truncate" style="font-size: 0.78rem;" title="<%= question.owner ? question.owner.name : 'Anonymous' %>">
                  <%= question.owner ? question.owner.name : 'Anonymous' %>
                </span>
                <span class="text-slate-muted text-truncate" style="font-size: 0.65rem;" title="<%= question.owner && question.owner.university ? question.owner.university : 'Global Campus' %>">
                  <%= question.owner && question.owner.university ? question.owner.university : 'Global Campus' %>
                </span>
              </div>
            </div>

            <!-- Custom Control Action Buttons -->
            <div class="d-flex align-items-center gap-2 flex-shrink-0">
              <% if (question.fileUrl && question.fileUrl.url) { %>
              <a href="<%= question.fileUrl.url %>" target="_blank" class="btn btn-download-circle rounded-circle d-flex align-items-center justify-content-center" title="Download Resource" style="width: 32px; height: 32px;">
                <i class="bi bi-download" style="font-size: 0.85rem;"></i>
              </a>
              <% } %>

              <!-- Refined Control View Button -->
              <button data-bs-toggle="modal" data-bs-target="#modal-<%= question._id %>" class="btn btn-sm btn-action-cyan rounded-3 px-3 fw-bold shadow-sm transition-all" style="font-size: 0.75rem; padding-top: 6px; padding-bottom: 6px;">
                Open <i class="bi bi-arrow-right-short ms-0.5"></i>
              </button>
            </div>

          </div>

        </div>
      </div>
    </div>


    <!-- Individual Detail Modal -->
    <!-- Modernized Modal Wrapper -->
    <div class="modal fade" id="modal-<%= question._id %>" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-3">

          <!-- Header -->
          <div class="modal-header bg-white border-bottom-0 pt-4 px-4 pb-2">
            <h5 class="modal-title fw-bold text-dark fs-4"><%= question.title %></h5>
            <button type="button" class="btn-close shadow-none" data-bs-dismiss="modal" aria-label="Close"></button>
          </div>

          <!-- Body -->
          <div class="modal-body px-4 pb-4 pt-2">
            <div class="row g-4">


              <!-- Left Column: Media Preview (With Multiple Image Support) -->
              <div class="col-md-5 d-flex flex-column align-items-center justify-content-start">
                <!-- বড় বা প্রধান ছবি (url অ্যারের প্রথম ছবি বা index 0 দেখানো হচ্ছে) -->
                <img src="<%= (question.imageUrl && question.imageUrl.url && question.imageUrl.url.length > 0) ? question.imageUrl.url[0] : 'https://unsplash.com' %>" class="img-fluid rounded-3 border w-100 object-fit-cover shadow-sm mb-2" alt="Banner" style="max-height: 220px;">

                <!-- বাকি ছবিগুলো ছোট আকারে দেখানোর জন্য লুপ (যদি url অ্যারেতে ১টির বেশি ছবি থাকে) -->
                <% if (question.imageUrl && question.imageUrl.url && question.imageUrl.url.length > 1) { %>
                <div class="d-flex gap-1 flex-wrap w-100 mt-1">
                  <% question.imageUrl.url.forEach(function(imgUrl) { %>

                  <img src="<%= imgUrl %>" class="img-thumbnail" style="width: 50px; height: 50px; object-fit: cover; cursor: pointer;">

                  <% }) %>
                </div>
                <% } %>
              </div>




              <!-- Right Column: Meta Info & Description -->
              <div class="col-md-7">
                <div class="p-3 bg-light rounded-3 mb-3 border border-light">
                  <div class="row g-2 small">
                    <div class="col-6 mb-1">
                      <span class="text-muted d-block" style="font-size: 0.75rem;">SUBJECT</span>
                      <span class="fw-semibold text-primary"><i class="bi bi-book me-1"></i><%= question.subject %></span>
                    </div>
                    <div class="col-6 mb-1">
                      <span class="text-muted d-block" style="font-size: 0.75rem;">YEAR & SESSION</span>
                      <span class="fw-semibold text-dark"><i class="bi bi-calendar-event me-1"></i><%= question.year || 'N/A' %> (<%= question.session || 'N/A' %>)</span>
                    </div>
                    <div class="col-12 mt-2 pt-2 border-top border-2 border-white">
                      <span class="text-muted d-block" style="font-size: 0.75rem;">UPLOADED BY</span>
                      <span class="fw-medium text-dark"><i class="bi bi-person-check me-1"></i><%= question.owner.name %></span>
                      <small class="text-muted d-block" style="font-size: 0.7rem;"><%= new Date(question.createdAt).toLocaleDateString(undefined, { year: 'numeric', month: 'short', day: 'numeric' }) %></small>
                    </div>
                  </div>
                </div>

                <h6 class="fw-bold text-secondary mb-2 small" style="letter-spacing: 0.5px;">DESCRIPTION</h6>
                <p class="text-secondary lh-base small" style="text-align: justify;"><%= question.description || 'No detailed description available.' %></p>
              </div>

            </div>
          </div>

          <!-- Footer -->
          <div class="modal-footer bg-light px-4 py-3 border-top-0 d-flex justify-content-between rounded-bottom-3">

            <!-- Left Side: Owner Actions (Differentiated with explicit semantic colors) -->
            <div class="d-flex gap-2">
              <% if (currentUser && currentUser._id.equals(question.owner._id)) { %>
              <a href="/question/<%= question._id %>/edit" class="btn btn-outline-warning btn-sm px-3 fw-medium">
                <i class="bi bi-pencil-square me-1"></i> Edit
              </a>
              <form action="/question/<%= question._id %>?_method=DELETE" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this question?');">
                <button type="submit" class="btn btn-outline-danger btn-sm px-3 fw-medium">
                  <i class="bi bi-trash3 me-1"></i> Delete
                </button>
              </form>
              <% } %>
            </div>

            <!-- Right Side: Standard Navigation Actions -->
            <div class="d-flex gap-2">
              <button type="button" class="btn btn-secondary btn-sm px-3 shadow-sm" data-bs-dismiss="modal">Close</button>
              <% if (question.fileUrl) { %>
              <a href="/question/<%= question._id %>" target="_blank" class="btn btn-primary btn-sm px-4 fw-medium shadow-sm">
                <i class="bi bi-cloud-arrow-down-fill me-1"></i> Open Attachment
              </a>
              <% } %>
            </div>

          </div>

        </div>
      </div>
    </div>


    <% }) %>
    <% } else { %>
    <!-- Empty State Container -->
    <div class="col-12 text-center py-5">
      <i class="bi bi-folder-x display-1 text-muted"></i>
      <h3 class="mt-3 text-secondary">No Questions Found</h3>
      <p class="text-muted">Get started by creating or importing sample items into your collection.</p>
    </div>
    <% } %>
  </div>
</main>