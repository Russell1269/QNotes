<% layout('LAYOUT/boilarplate') -%>

<div
  class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light-gradient py-5"
>
  <div class="row w-100 justify-content-center">
    <div class="col-10 col-sm-8 col-md-6 col-lg-4">
      <!-- মেইন লগইন কার্ড -->
      <div class="card border-0 shadow-lg signup-card-custom p-4 p-sm-5">
        <!-- ব্র্যান্ড লোগো এবং হেডার সেকশন -->
        <div class="text-center mb-4">
          <div
            class="brand-icon-wrapper mb-3 mx-auto d-flex align-items-center justify-content-center"
          >
            <i class="fa-solid fa-graduation-cap text-primary fs-3"></i>
          </div>
          <h3 class="fw-bold text-dark mb-1">Welcome Back</h3>
          <p class="text-muted small">
            Log in to manage your university note workspace
          </p>
        </div>

        <!-- লগইন ফর্ম -->
        <form action="/login" method="POST" class="needs-validation" novalidate>
          <!-- ইউজারনেম ফিল্ড -->
          <div class="form-floating mb-3">
            <input
              type="text"
              class="form-control input-custom"
              id="username"
              name="username"
              placeholder="johndoe"
              required
              autocomplete="username"
            />
            <label for="username" class="text-muted"
              ><i class="fa-regular fa-user me-2"></i>Username or Email</label
            >
            <div class="invalid-feedback">
              Please enter your username handle.
            </div>
          </div>

          <!-- পাসওয়ার্ড ফিল্ড -->
          <div class="form-floating mb-3">
            <input
              type="password"
              class="form-control input-custom"
              id="password"
              name="password"
              placeholder="Password"
              required
              autocomplete="current-password"
            />
            <label for="password" class="text-muted"
              ><i class="fa-solid fa-lock me-2"></i>Password</label
            >
            <div class="invalid-feedback">
              Please verify your user password authentication.
            </div>
          </div>

          <!-- রিমেম্বার মি এবং ফরগট পাসওয়ার্ড (ঐচ্ছিক কিন্তু প্রফেশনাল লুকের জন্য) -->
          <div class="d-flex justify-content-between align-items-center mb-4">
            <div class="form-check">
              <input class="form-check-input" type="checkbox" id="rememberMe" />
              <label class="form-check-label text-muted small" for="rememberMe"
                >Remember me</label
              >
            </div>
            <!-- <a
              href="#"
              class="text-decoration-none small fw-semibold text-primary"
              >Forgot Password?</a
            > -->
          </div>

          <!-- মেইন সাবমিট বাটন -->
          <button
            class="btn btn-primary w-100 py-2.5 fw-bold shadow-sm mb-4 btn-login-custom"
            type="submit"
          >
            Log In <i class="fa-solid fa-arrow-right-to-bracket ms-2"></i>
          </button>

          <!-- ডিভাইডার (অথবা গুগলের জন্য) -->
          <div class="position-relative text-center my-4">
            <hr class="text-muted" />
            <span
              class="position-absolute top-50 start-50 translate-middle bg-white px-3 text-muted small"
              >or continue with</span
            >
          </div>

          <!-- প্রফেশনাল গুগল লগইন বাটন -->
          <a
            href="/google"
            class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center fw-semibold mb-4 btn-google-custom"
          >
            <svg
              class="me-2"
              xmlns="http://w3.org"
              width="18"
              height="18"
              viewBox="0 0 24 24"
            >
              <path
                fill="#4285F4"
                d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v3.92h6.69c-.29 1.5-1.14 2.78-2.4 3.63v3.02h3.88c2.28-2.1 3.57-5.19 3.57-8.5z"
              />
              <path
                fill="#34A853"
                d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.02c-1.08.72-2.45 1.16-4.05 1.16-3.11 0-5.74-2.11-6.68-4.96H1.21v3.11C3.18 21.88 7.39 24 12 24z"
              />
              <path
                fill="#FBBC05"
                d="M5.32 14.27c-.24-.72-.37-1.49-.37-2.27s.13-1.55.37-2.27V6.62H1.21C.44 8.24 0 10.07 0 12s.44 3.76 1.21 5.38l4.11-3.11z"
              />
              <path
                fill="#EA4335"
                d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.44-3.44C17.93 1.19 15.22 0 12 0 7.39 0 3.18 2.12 1.21 5.38l4.11 3.11c.94-2.85 3.57-4.96 6.68-4.96z"
              />
            </svg>
            Sign in with Google
          </a>

          <!-- ফুটার লিংক -->
          <div class="text-center">
            <p class="text-muted small mb-0">
              Don't have an account?
              <a
                href="/signup"
                class="text-decoration-none fw-bold text-primary ms-1"
                >Sign Up</a
              >
            </p>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
