<% layout('LAYOUT/boilarplate') -%>

<div class="auth-wrapper py-5">
  <div class="auth-card">
    <!-- Header -->
    <div class="text-center mb-4">
      <h2 class="auth-title mb-1">Create your QNotes profile</h2>
      <p class="auth-subtitle">
        Keep your university lectures and research organized
      </p>
    </div>

    <!-- Signup Form -->
    <form action="/signup" method="POST" class="needs-validation" novalidate>
      <!-- 1. Full Name -->
      <div class="form-floating mb-3">
        <input
          type="text"
          class="form-control"
          id="name"
          name="name"
          placeholder="John Doe"
          required
          autocomplete="name"
        />
        <label for="name"
          ><i class="fa-regular fa-id-card me-2"></i>Full Name</label
        >
        <div class="invalid-feedback">Please enter your full name.</div>
      </div>

      <!-- 2. University Name -->
      <div class="form-floating mb-3">
        <input
          type="text"
          class="form-control"
          id="university"
          name="university"
          placeholder="University Name"
          required
        />
        <label for="university"
          ><i class="fa-solid fa-graduation-cap me-2"></i>University Name</label
        >
        <div class="invalid-feedback">Please provide your university name.</div>
      </div>

      <!-- 3. Username (Required by passport-local-mongoose) -->
      <div class="form-floating mb-3">
        <input
          type="text"
          class="form-control"
          id="username"
          name="username"
          placeholder="johndoe123"
          required
          autocomplete="username"
        />
        <label for="username"
          ><i class="fa-regular fa-user me-2"></i>Username</label
        >
        <div class="invalid-feedback">
          Please choose a unique identifier handle.
        </div>
      </div>

      <!-- 4. Email Field -->
      <div class="form-floating mb-3">
        <input
          type="email"
          class="form-control"
          id="email"
          name="email"
          placeholder="name@university.edu"
          required
          autocomplete="email"
        />
        <label for="email"
          ><i class="fa-regular fa-envelope me-2"></i>Email Address</label
        >
        <div class="invalid-feedback">
          Please enter a valid active email connection.
        </div>
      </div>

      <!-- 5. Password Field (Required by passport-local-mongoose backend) -->
      <div class="form-floating mb-4">
        <input
          type="password"
          class="form-control"
          id="password"
          name="password"
          placeholder="Password"
          required
          minlength="6"
          autocomplete="new-password"
        />
        <label for="password"
          ><i class="fa-solid fa-lock me-2"></i>Password</label
        >
        <div class="invalid-feedback">
          Security password needs a 6 character threshold limit.
        </div>
      </div>

      <!-- Submit Button -->
      <button class="btn btn-auth w-100 mb-4 shadow-sm" type="submit">
        Sign Up
      </button>

      <!-- google-signup -->
       <a
            href="/google"
            class="btn btn-outline-secondary w-100 py-2 d-flex align-items-center justify-content-center fw-semibold mb-4 btn-google-custom"
          >
            <svg
              class="me-2"
              xmlns="http://w3.org"
              width="18"
              height="18"
              viewBox="0 0 24 24"
            >
              <path
                fill="#4285F4"
                d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v3.92h6.69c-.29 1.5-1.14 2.78-2.4 3.63v3.02h3.88c2.28-2.1 3.57-5.19 3.57-8.5z"
              />
              <path
                fill="#34A853"
                d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.02c-1.08.72-2.45 1.16-4.05 1.16-3.11 0-5.74-2.11-6.68-4.96H1.21v3.11C3.18 21.88 7.39 24 12 24z"
              />
              <path
                fill="#FBBC05"
                d="M5.32 14.27c-.24-.72-.37-1.49-.37-2.27s.13-1.55.37-2.27V6.62H1.21C.44 8.24 0 10.07 0 12s.44 3.76 1.21 5.38l4.11-3.11z"
              />
              <path
                fill="#EA4335"
                d="M12 4.75c1.77 0 3.35.61 4.6 1.8l3.44-3.44C17.93 1.19 15.22 0 12 0 7.39 0 3.18 2.12 1.21 5.38l4.11 3.11c.94-2.85 3.57-4.96 6.68-4.96z"
              />
            </svg>
            Sign up with Google
          </a>

      <!-- Toggle Link -->
      <div class="text-center">
        <p class="auth-footer-text mb-0">
          Already registered? <a href="/login" class="auth-link">Log In</a>
        </p>
      </div>
    </form>
  </div>
</div>
